<!-- 主窗口 — 单页 2×2 布局 -->
<Window x:Class="AutoClicker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标连点器" Width="645" Height="690" MinWidth="580" MinHeight="500"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorBackground}" Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource ColorBackground}">
            <Grid Margin="16,8,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 点击目标 + 点击模式 -->
                <GroupBox Grid.Row="0" Grid.Column="0" Header="点击目标" VerticalAlignment="Stretch">
                    <StackPanel>
                        <RadioButton x:Name="RbCurrentPos" Content="当前光标位置" GroupName="ClickTarget"
                                     IsChecked="True" Click="OnClickTargetCurrent"/>
                        <RadioButton x:Name="RbFixedPos" Content="固定屏幕位置" GroupName="ClickTarget"
                                     Margin="0,0,0,6" Click="OnClickTargetFixed"/>
                        <Border Padding="12" Margin="0,6,0,0" Background="{StaticResource ColorBackground}"
                                CornerRadius="8" Visibility="{Binding UseFixedPosition,Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="X: " FontWeight="SemiBold" Foreground="{StaticResource ColorTextSecondary}"/>
                                    <TextBlock Text="{Binding TargetX}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                    <TextBlock Text="  Y: " FontWeight="SemiBold" Foreground="{StaticResource ColorTextSecondary}"/>
                                    <TextBlock Text="{Binding TargetY}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                </StackPanel>
                                <Button Content="选取坐标" HorizontalAlignment="Right" Width="90" Padding="10,6"
                                        Command="{Binding PickCoordinatesCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="0" Grid.Column="2" Header="点击模式" VerticalAlignment="Stretch">
                    <StackPanel>
                        <RadioButton x:Name="RbModeSingle" Content="左键单击" GroupName="ClickMode" Checked="OnClickModeSingle"/>
                        <RadioButton x:Name="RbModeDouble" Content="左键双击" GroupName="ClickMode" Checked="OnClickModeDouble"/>
                        <RadioButton x:Name="RbModeRight" Content="右键单击" GroupName="ClickMode" Checked="OnClickModeRight"/>
                        <RadioButton x:Name="RbModeMiddle" Content="中键单击（滚轮）" GroupName="ClickMode" Checked="OnClickModeMiddle"/>
                    </StackPanel>
                </GroupBox>

                <!-- Row 1: 点击间隔 + 鼠标宏录制 -->
                <GroupBox Grid.Row="1" Grid.Column="0" Header="点击间隔" VerticalAlignment="Stretch">
                    <StackPanel>
                        <RadioButton x:Name="RbIntervalMs" Content="毫秒 (ms)" GroupName="IntervalMode" Checked="OnIntervalMs"/>
                        <Border Padding="4,0,4,8" Visibility="{Binding IsMsMode,Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding IntervalMs,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource TextHint}" Text="50 – 60000 毫秒"/>
                            </StackPanel>
                        </Border>
                        <RadioButton x:Name="RbIntervalCps" Content="CPS（每秒点击数）" GroupName="IntervalMode" Checked="OnIntervalCps"/>
                        <Border Padding="4,0,4,8" Visibility="{Binding IsCpsMode,Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding Cps,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource TextHint}" Text="1 – 100 次/秒"/>
                            </StackPanel>
                        </Border>
                        <RadioButton x:Name="RbIntervalHold" Content="长按持续" GroupName="IntervalMode" Checked="OnIntervalHold"/>
                        <Border Padding="4,0,4,8" Visibility="{Binding IsHoldMode,Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding HoldDurationMs,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource TextHint}" Text="长按持续时间（毫秒）"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1" Grid.Column="2" Header="鼠标宏录制" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Button Height="36" Margin="0,0,0,8" Command="{Binding ToggleRecordingCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="False"><Setter Property="Content" Value="开始录制 (F8)"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Content" Value="停止录制 (F8)"/><Setter Property="Background" Value="{StaticResource ColorDanger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="36" Content="播放录制 (F9)" Command="{Binding PlayRecordingCommand}" IsEnabled="{Binding HasRecording}"/>
                            <Button Grid.Column="2" Content="清空录制" Height="36" Padding="14,8"
                                    Style="{StaticResource ButtonSecondary}" Command="{Binding ClearRecordingCommand}" IsEnabled="{Binding HasRecording}"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="重复" VerticalAlignment="Center" Style="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="2" Width="56" Height="28" x:Name="TbRepeatCount" Padding="4,0"
                                     Text="{Binding RepeatCount,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"
                                     FontSize="12" PreviewTextInput="OnRepeatCountPreviewInput" LostFocus="OnRepeatCountLostFocus"/>
                            <TextBlock Grid.Column="4" Text="次" VerticalAlignment="Center" Style="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="6" Height="28" FontSize="12" Padding="8,4" HorizontalAlignment="Stretch"
                                    Content="循环播放 (F10)" Command="{Binding LoopPlayRecordingCommand}" IsEnabled="{Binding HasRecording}"/>
                        </Grid>
                        <Border Padding="10,6" Margin="0,8,0,0" Background="{StaticResource ColorBackground}" CornerRadius="8"
                                Visibility="{Binding IsRecording,Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TextSecondary}">
                                <Run Text="已捕获 "/><Run Text="{Binding RecordingEventCount}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                                <Run Text=" 个事件  |  时长 "/><Run Text="{Binding RecordingDuration}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Row 2: 定时点击任务 -->
                <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="定时点击任务" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="任务名称" VerticalAlignment="Center" Style="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="2" Height="30" Text="{Binding NewTaskLabel,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="延迟" VerticalAlignment="Center" Style="{StaticResource TextSecondary}"/>
                            <TextBox Grid.Column="6" Height="30" Text="{Binding NewTaskDelayValue,UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                            <ComboBox Grid.Column="8" Height="30" ItemsSource="{Binding TimeUnitOptions}"
                                      SelectedIndex="{Binding SelectedTimeUnitIndex}" FontSize="12" VerticalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Margin="0,4,0,8" Style="{StaticResource TextHint}" Text="{Binding NewTaskDelayDisplay}"/>
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource TextHint}">
                            <Run Text="当前目标: ("/><Run Text="{Binding TargetX}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                            <Run Text=", "/><Run Text="{Binding TargetY}" FontWeight="Bold" Foreground="{StaticResource ColorPrimary}"/>
                            <Run Text=") — "/><Run Text="{Binding SelectedClickModeDisplay,Mode=OneWay}"/>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="添加任务" Height="36" Command="{Binding AddScheduledTaskCommand}"/>
                            <Button Grid.Column="2" Content="计划列表" Height="36" Padding="14,8" Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding ShowPlanListCommand}"/>
                            <Button Grid.Column="4" Content="开始执行" Height="36" Padding="14,8"
                                    Command="{Binding StartScheduledTasksCommand}" IsEnabled="{Binding IsScheduledRunning,Converter={StaticResource BoolInverse}}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource ColorSuccess}"/></Style></Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Row 3: 键盘触发 + 主操作按钮 -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" VerticalAlignment="Stretch" Padding="10" Background="{StaticResource ColorSurface}" CornerRadius="12"
                            BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="触发按键：" VerticalAlignment="Center" Style="{StaticResource TextSecondary}"/>
                            <Border Grid.Column="2" Padding="12,4" MinWidth="80" Background="{StaticResource ColorBackground}"
                                    CornerRadius="6" BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                                <TextBlock Text="{Binding TriggerKeyDisplay}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="4" Width="72" Padding="4,6" FontSize="12"
                                    Command="{Binding RecordTriggerKeyCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="录键绑定"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListeningForKey}" Value="True">
                                                <Setter Property="Content" Value="请按键..."/><Setter Property="Background" Value="{StaticResource ColorDanger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="6" Width="72" Padding="4,6" FontSize="12"
                                    Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding ShowTriggerBindListCommand}">绑定列表</Button>
                            <Button Grid.Column="8" Width="60" Padding="4,6" FontSize="12"
                                    Command="{Binding ToggleKeyboardTriggerCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KeyboardTriggerEnabled}" Value="False"><Setter Property="Content" Value="已关闭"/></DataTrigger>
                                            <DataTrigger Binding="{Binding KeyboardTriggerEnabled}" Value="True">
                                                <Setter Property="Content" Value="已开启"/><Setter Property="Background" Value="{StaticResource ColorSuccess}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" VerticalAlignment="Stretch" FontSize="14" FontWeight="Bold"
                            MinWidth="130"
                            Command="{Binding ToggleClickingCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource ColorSuccess}"/><Setter Property="Content" Value="开始 (F6)"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ColorDanger}"/><Setter Property="Content" Value="停止 (F6)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border Grid.Row="1" Padding="16,8" Background="{StaticResource ColorSurface}"
                BorderBrush="{StaticResource ColorBorderLight}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Fill><Binding Path="IsRunning" Converter="{StaticResource BoolToColor}"/></Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="快捷键: F6 开始/停止  |  F7 急停  |  F8 录制  |  F9 播放  |  F10 循环"
                           FontSize="11" Foreground="{StaticResource ColorTextMuted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
