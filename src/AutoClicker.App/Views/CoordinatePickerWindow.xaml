<!--
  坐标选取覆盖层窗口
  全屏半透明遮罩，用户点击任意位置获取屏幕坐标，ESC 取消
-->
<Window x:Class="AutoClicker.App.Views.CoordinatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowState="Maximized"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
    </Window.Resources>
    <Grid>
        <!-- 半透明覆盖层 -->
        <Grid.Background>
            <SolidColorBrush Color="#22000000" />
        </Grid.Background>

        <!-- 操作提示 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="点击任意位置选取坐标"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock Text="按 ESC 取消"
                       FontSize="13"
                       Foreground="#A0A0A0"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
