<!-- 键盘触发设置窗口 — 监听开关、前台窗口过滤、自动暂停策略 -->
<Window x:Class="AutoClicker.App.Views.TriggerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘触发设置" Width="520" Height="640"
        MinWidth="460" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource ColorBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 键盘监听 -->
                <GroupBox Header="键盘监听">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" FontSize="13">
                                    <Run Text="当前状态："/>
                                    <Run Text="{Binding KeyboardListenerStateText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource TextHint}" Margin="0,2,0,0"
                                           Text="监听开启后，按下已绑定的按键才会触发点击。"/>
                            </StackPanel>
                            <Button Grid.Column="1" Width="100" Height="34" Padding="6,4" FontSize="12"
                                    Content="{Binding KeyboardTriggerToggleText}"
                                    Command="{Binding ToggleKeyboardTriggerCommand}"
                                    IsEnabled="{Binding IsPaused, Converter={StaticResource BoolInverse}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KeyboardTriggerEnabled}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ColorDanger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <CheckBox Content="启动软件时自动恢复监听"
                                  IsChecked="{Binding AutoResumeListeningOnStartup}"/>
                        <TextBlock Style="{StaticResource TextHint}" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="默认不勾选：每次启动都处于暂停状态，需要按 F7 恢复。勾选后启动即运行，并恢复上次的监听开关。"/>
                    </StackPanel>
                </GroupBox>

                <!-- 前台窗口过滤 -->
                <GroupBox Header="前台窗口过滤">
                    <StackPanel>
                        <CheckBox Content="仅当指定程序在前台时才触发点击"
                                  IsChecked="{Binding TriggerWindowFilterEnabled}"/>
                        <TextBlock Style="{StaticResource TextHint}" Margin="26,4,0,8" TextWrapping="Wrap"
                                   Text="推荐开启。开启后，在浏览器、聊天框、编辑器里按同一个键不会触发点击。"/>

                        <Border Background="{StaticResource ColorBackground}" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding TriggerWindowProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="✕" Width="26" Height="22"
                                                    Padding="0" FontSize="10"
                                                    Style="{StaticResource ButtonSecondary}"
                                                    Command="{Binding DataContext.RemoveTriggerProcessCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Height="32" FontSize="12"
                                     Text="{Binding TriggerProcessInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 game.exe"/>
                            <Button Grid.Column="2" Content="添加" Width="64" Height="32" Padding="6,4" FontSize="12"
                                    Command="{Binding AddTriggerProcessCommand}"/>
                        </Grid>

                        <Button Content="捕获当前前台窗口（3 秒后）" Height="32" FontSize="12" Padding="6,4"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding CaptureForegroundProcessCommand}"/>
                        <TextBlock Text="{Binding ForegroundCaptureStatus}" Style="{StaticResource TextHint}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="列表为空时，任何程序都不会触发点击。若目标程序以管理员身份运行，本软件也需要以管理员身份启动，否则可能读不到进程名。"/>
                    </StackPanel>
                </GroupBox>

                <!-- 自动暂停 -->
                <GroupBox Header="自动暂停">
                    <StackPanel>
                        <CheckBox Content="关闭窗口到托盘时暂停全部"
                                  IsChecked="{Binding PauseWhenMinimizedToTray}"/>
                        <CheckBox Content="锁屏时暂停全部" Margin="0,8,0,0"
                                  IsChecked="{Binding PauseWhenLocked}"/>
                        <TextBlock Style="{StaticResource TextHint}" Margin="26,6,0,0" TextWrapping="Wrap"
                                   Text="暂停后不会自动重启之前的连点/回放任务，需要手动开始。"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭" Height="36" Margin="0,12,0,0"
                Style="{StaticResource ButtonSecondary}" Click="Close_Click"/>
    </Grid>
</Window>
