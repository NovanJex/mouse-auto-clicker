<!--
  关闭行为对话框 — 点击窗口 X 按钮时弹出
  用户可选择"退出应用"或"最小化到托盘"
-->
<Window x:Class="AutoClicker.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠标连点器" Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ColorBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 感叹号图标 + 提示文字 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 圆形感叹号图标 -->
            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                <Ellipse Width="28" Height="28" Fill="{StaticResource ColorPrimary}" />
                <TextBlock Text="!" FontSize="16" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 提示文字（自动换行） -->
            <TextBlock Grid.Column="2" FontSize="14"
                       Foreground="{StaticResource ColorTextPrimary}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="关闭窗口后程序将退出，你也可以选择最小化到系统托盘在后台继续运行。"/>
        </Grid>

        <!-- 记住选择 -->
        <CheckBox x:Name="CbRemember" Grid.Row="1" Margin="42,0,0,16"
                  Content="记住我的选择，下次不再提示"
                  Foreground="{StaticResource ColorTextSecondary}"
                  FontSize="12" Cursor="Hand"/>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnExit" Content="退出应用"
                    Width="110" Height="36" Margin="0,0,10,0"
                    Style="{StaticResource ButtonSecondary}"
                    Click="OnExitClick"/>
            <Button x:Name="BtnTray" Content="最小化到托盘"
                    Width="130" Height="36"
                    Style="{StaticResource ButtonSecondary}"
                    Click="OnTrayClick"/>
        </StackPanel>
    </Grid>
</Window>
